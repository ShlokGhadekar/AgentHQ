# Copy this file to .env and fill in at least one key. Never commit .env.
# docker compose reads it for both the backend and RepoLens.

# --- LLM ----------------------------------------------------------------------
# Which provider the agents use: groq (default) or anthropic.
LLM_PROVIDER=groq
# Groq has a free tier: https://console.groq.com/keys
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# Default model for agents that don't set one in agents.yaml.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_S=60

# --- RepoLens -----------------------------------------------------------------
# Folder with the RepoLens source code, used by docker compose to build the image.
REPOLENS_PATH=../RepoLens
# Where the backend reaches RepoLens. Inside compose this is overridden to http://repolens:8000.
# REPOLENS_URL=http://localhost:8000

# --- Infrastructure (defaults match docker compose; change only for a custom setup) ---
# DATABASE_URL=postgresql+asyncpg://agenthq:agenthq@localhost:5432/agenthq
# REDIS_URL=redis://localhost:6379/0
