# Copy this file to .env and fill in at least one key. Never commit .env.
# docker compose reads it for both the backend and RepoLens.

# --- LLM ----------------------------------------------------------------------
# Default provider: gemini, groq, cerebras or anthropic. Agents pick their own with `provider:` in
# backend/agenthq/agents.yaml (currently Gemini for all four, so GEMINI_API_KEY is required).
LLM_PROVIDER=gemini
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free tier, used by RepoLens: https://console.groq.com/keys
GROQ_API_KEY=
# CEREBRAS_API_KEY=
# ANTHROPIC_API_KEY=
# Default model for agents that don't set one in agents.yaml.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT_S=60

# --- RepoLens -----------------------------------------------------------------
# Folder with the RepoLens source code, used by docker compose to build the image.
REPOLENS_PATH=../RepoLens
# Where the backend reaches RepoLens. Inside compose this is overridden to http://repolens:8000.
# REPOLENS_URL=http://localhost:8000

# --- Infrastructure (defaults match docker compose; change only for a custom setup) ---
# DATABASE_URL=postgresql+asyncpg://agenthq:agenthq@localhost:5432/agenthq
# REDIS_URL=redis://localhost:6379/0

# --- GitHub -------------------------------------------------------------------
# Used only after a human approves a run's changes: pushes a branch and opens the pull request.
# Use a fine-grained token limited to the target repo, with Contents and Pull requests: Read and write.
# GITHUB_TOKEN=
