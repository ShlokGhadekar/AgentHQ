--- a/app/notes.py
+++ b/app/notes.py
@@ -36,6 +36,13 @@ def read_note(note_id: int, user: User = Depends(get_current_user)) -> NoteOut:
     return to_out(get_own_note(note_id, user))
 
 
+@router.put("/{note_id}", response_model=NoteOut)
+def update_note(note_id: int, body: NoteCreate, user: User = Depends(get_current_user)) -> NoteOut:
+    note = get_own_note(note_id, user)
+    note.title, note.body = body.title, body.body
+    return to_out(note)
+
