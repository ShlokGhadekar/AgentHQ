+    def delete_user(self, user: User) -> None:
+        """Remove the user with their notes and sessions."""
+        del self.users[user.username]
+        self.notes = {i: n for i, n in self.notes.items() if n.owner_id != user.id}
+        self.sessions = {t: s for t, s in self.sessions.items() if s.user_id != user.id}
+
     def notes_for(self, owner_id: int) -> list[Note]:
         return [n for n in self.notes.values() if n.owner_id == owner_id]
 
