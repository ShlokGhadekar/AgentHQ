+def list_notes(q: str | None = None, user: User = Depends(get_current_user)) -> list[NoteOut]:
+    notes = sorted(store.notes_for(user.id), key=lambda n: n.id)
+    if q:
+        needle = q.lower()
+        notes = [n for n in notes if needle in n.title.lower() or needle in n.body.lower()]
+    return [to_out(note) for note in notes]
 
 
 @router.post("", status_code=status.HTTP_201_CREATED, response_model=NoteOut)
