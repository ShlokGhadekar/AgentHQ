-from pydantic import BaseModel, Field
+from pydantic import BaseModel, Field, field_validator
 
 from app.config import settings
 
@@ -31,6 +31,12 @@ class NoteCreate(BaseModel):
     title: str = Field(min_length=1, max_length=settings.max_title_length)
     body: str = Field(default="", max_length=settings.max_body_length)
 
+    @field_validator("title", mode="before")
+    @classmethod
+    def strip_title(cls, value: object) -> object:
+        # Strip before the length check, so a title of only spaces counts as empty.
+        return value.strip() if isinstance(value, str) else value
+
 
 class NoteOut(BaseModel):
     id: int
