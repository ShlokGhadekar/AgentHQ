 """Registration, login and the current-user dependency."""
 
+import time
 from datetime import UTC, datetime, timedelta
 
-from fastapi import APIRouter, Depends, HTTPException, status
+from fastapi import APIRouter, Depends, HTTPException, Request, status
 from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
 
 from app.config import settings
@@ -23,8 +24,24 @@ def register(body: UserCreate) -> UserOut:
     return UserOut(id=user.id, username=user.username)
 
 
+LOGIN_LIMIT = 5
+LOGIN_WINDOW_S = 60
+
+
+def check_login_rate(client_ip: str) -> None:
+    """Allow LOGIN_LIMIT attempts per client IP in any LOGIN_WINDOW_S seconds; every attempt counts."""
+    now = time.monotonic()
+    recent = [t for t in store.login_attempts.get(client_ip, []) if now - t < LOGIN_WINDOW_S]
+    if len(recent) >= LOGIN_LIMIT:
+        retry_after = int(LOGIN_WINDOW_S - (now - recent[0])) + 1
+        raise HTTPException(status.HTTP_429_TOO_MANY_REQUESTS, "Too many login attempts",
+                            headers={"Retry-After": str(retry_after)})
+    store.login_attempts[client_ip] = [*recent, now]
+
+
 @router.post("/login", response_model=TokenOut)
-def login(body: LoginRequest) -> TokenOut:
+def login(body: LoginRequest, request: Request) -> TokenOut:
+    check_login_rate(request.client.host if request.client else "unknown")
     user = store.users.get(body.username)
     if user is None or not verify_password(body.password, user.salt, user.password_hash):
         raise HTTPException(status.HTTP_401_UNAUTHORIZED, "Invalid username or password")
